{
  "answer_prefix": "ai",
  "task_prefix": "hr",
  "litellm": {
    "base_url": "http://localhost:4000/v1",
    "model": "local-fast",
    "timeout_s": 45,
    "api_key_env": "LITELLM_API_KEY",
    "api_key_file": ""
  },
  "max_answer_chars": 700,
  "copy_answers": true,
  "notify_icon": "help-browser",
  "web_search_url": "https://duckduckgo.com/?q=%s",
  "web_search_name": "DUCKDUCKGO",
  "models": ["local-fast", "local-heavy", "local-fast-reason", "cloud-dev"],
  "handoffs": [
    {"prefix": "gh",  "label": "GitHub",       "url": "https://github.com/search?q=%s"},
    {"prefix": "sea", "label": "SearXNG fleet", "url": "http://192.168.1.249:8787/search?q=%s"},
    {"prefix": "el",  "label": "Elastic docs", "url": "https://duckduckgo.com/?q=site%3Aelastic.co+%s"}
  ]
}
